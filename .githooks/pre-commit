#!/bin/sh
# Barra dados pessoais e segredos nas linhas adicionadas (o repo pode virar público).
diff=$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++')
fail=0
check() {
  hits=$(printf '%s\n' "$diff" | grep -nE "$2" | grep -vE "$3")
  if [ -n "$hits" ]; then echo "pre-commit: $1"; printf '%s\n' "$hits" | head -5; fail=1; fi
}
check "e-mail encontrado" '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' 'noreply@anthropic\.com|users\.noreply\.github\.com'
check "telefone encontrado" '(\(?[0-9]{2}\)?[ .-]?)?9[0-9]{4}[ .-]?[0-9]{4}' '"(lat|lng)"|[0-9]\.[0-9]{5,}'
check "chave ou token encontrado" 'AIza[0-9A-Za-z_-]{20,}|gh[opsu]_[0-9A-Za-z]{20,}|sk-[0-9A-Za-z]{20,}' '^$'
[ $fail -eq 0 ] || { echo "Revise. Para forçar (só se tiver certeza): git commit --no-verify"; exit 1; }
